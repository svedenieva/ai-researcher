# AI-Researcher environment. Copy to .env.local and fill in.
# Secrets (service key, MCP tokens) must never reach the browser.

# ── Supabase (server) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
DATA_SOURCE=supabase          # omit / any other value = in-memory store (dev, tests)

# ── Supabase (browser / auth) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Access ──
ALLOWED_EMAILS=you@example.com,teammate@example.com   # Google-login allowlist (comma-separated)
MCP_TOKENS=some-token:you@example.com                 # HTTP MCP auth: token:email pairs

# ── Optional: research_decompose provider (else a structural heuristic) ──
ANTHROPIC_API_KEY=
RESEARCH_MODEL=claude-opus-5
OPENROUTER_API_KEY=                                    # stdio MCP decompose fallback
